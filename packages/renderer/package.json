{
  "name": "@lingui/renderer",
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/lingui-renderer.js"
    },
    "./core": {
      "types": "./src/core.ts",
      "import": "./dist/lingui-renderer.js"
    },
    "./style.css": "./src/renderer-core/renderer.css",
    "./catalog": "./schemas/catalog.json"
  },
  "scripts": {
    "format": "prettier --write src --ignore-path ../../.prettierignore",
    "build": "vite build --config vite.config.lib.ts && vite build --config vite.config.reader.ts",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "dev": "vite",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@openuidev/lang-core": "0.4.1",
    "@openuidev/svelte-lang": "0.4.1",
    "ajv": "^8.17.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.13.3",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.43.14",
    "svelte-check": "^4.3.4",
    "terser": "^5.44.1",
    "typescript": "~5.8.3",
    "vite": "^7.2.7"
  }
}
